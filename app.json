{
  "expo": {
    "name": "Kickoff",
    "slug": "kickoff",
    "scheme": "kickoff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F0D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.akbar.soccer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kickoff uses your location to show pickup games near you."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.akbar.soccer",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kickoff uses your location to show pickup games near you."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.akbar.soccer",
          "enableGooglePay": true
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "REPLACE_WITH_ANDROID_MAPS_KEY"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "./plugins/withoutReleaseLint"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7ba920ed-6720-4b6d-85b7-4554b5a7ee91"
      }
    },
    "owner": "akbar1982"
  }
}
